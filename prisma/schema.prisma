generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  permissions Json        @default("[]")
  createdAt   DateTime    @default(now()) @map("created_at")
  users       AdminUser[]

  @@map("roles")
}

model AdminUser {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  passwordHash       String         @map("password_hash")
  name               String
  roleId             String         @map("role_id") @db.Uuid
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  sessions           AdminSession[]
  role               Role           @relation(fields: [roleId], references: [id])
  assets             MediaAsset[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model Category {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  slug      String        @unique
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  apps      Application[]

  @@map("categories")
}

model Platform {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @unique
  slug      String                @unique
  sortOrder Int                   @default(0) @map("sort_order")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  apps      ApplicationPlatform[]

  @@map("platforms")
}

model Application {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  slug             String                @unique
  tagline          String                @default("")
  shortDescription String                @default("") @map("short_description")
  description      String                @default("")
  categoryId       String?               @map("category_id") @db.Uuid
  pricingLabel     String?               @map("pricing_label")
  bundleId         String?               @map("bundle_id")
  featured         Boolean               @default(false)
  displayOrder     Int                   @default(0) @map("display_order")
  contentState     AppContentState       @default(DRAFT) @map("content_state")
  availability     AppAvailability       @default(AVAILABLE)
  seoTitle         String?               @map("seo_title")
  seoDescription   String?               @map("seo_description")
  iconUrl          String?               @map("icon_url")
  coverUrl         String?               @map("cover_url")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  features         ApplicationFeature[]
  media            ApplicationMedia[]
  platforms        ApplicationPlatform[]
  category         Category?             @relation(fields: [categoryId], references: [id])
  messages         ContactMessage[]
  faqs             FAQ[]
  articles         HelpArticle[]
  legalDocuments   LegalDocument[]
  releases         Release[]

  @@index([contentState, availability, featured, displayOrder])
  @@map("applications")
}

model ApplicationPlatform {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  platformId    String      @map("platform_id") @db.Uuid
  url           String?
  label         String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  platform      Platform    @relation(fields: [platformId], references: [id])

  @@unique([applicationId, platformId])
  @@map("application_platforms")
}

model ApplicationFeature {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  title         String
  body          String      @default("")
  sortOrder     Int         @default(0) @map("sort_order")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, sortOrder])
  @@map("application_features")
}

model MediaAsset {
  id               String             @id @default(uuid()) @db.Uuid
  storageKey       String             @unique @map("storage_key")
  originalFilename String             @map("original_filename")
  storedName       String             @map("stored_name")
  mimeType         String             @map("mime_type")
  size             Int
  width            Int?
  height           Int?
  altText          String             @default("") @map("alt_text")
  uploadedBy       String?            @map("uploaded_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  deleteUrl        String?            @map("delete_url")
  links            ApplicationMedia[]
  uploader         AdminUser?         @relation(fields: [uploadedBy], references: [id])

  @@map("media_assets")
}

model ApplicationMedia {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  assetId       String      @map("asset_id") @db.Uuid
  role          MediaRole
  sortOrder     Int         @default(0) @map("sort_order")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  asset         MediaAsset  @relation(fields: [assetId], references: [id])

  @@unique([applicationId, assetId, role])
  @@map("application_media")
}

model Release {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  version       String
  title         String
  description   String          @default("")
  releaseDate   DateTime        @default(now()) @map("release_date")
  status        ReleaseState    @default(DRAFT)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  changes       ReleaseChange[]
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@index([applicationId, status, releaseDate])
  @@map("releases")
}

model ReleaseChange {
  id        String            @id @default(uuid()) @db.Uuid
  releaseId String            @map("release_id") @db.Uuid
  kind      ReleaseChangeKind
  text      String
  sortOrder Int               @default(0) @map("sort_order")
  release   Release           @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@map("release_changes")
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  content        Json          @default("{}")
  published      Boolean       @default(true)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  sections       PageSection[]

  @@map("pages")
}

model PageSection {
  id        String  @id @default(uuid()) @db.Uuid
  pageId    String  @map("page_id") @db.Uuid
  kind      String
  data      Json
  visible   Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_sections")
}

model LegalDocument {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  slug           String       @unique
  type           String
  content        String
  effectiveDate  DateTime?    @map("effective_date")
  updatedDate    DateTime?    @map("updated_date")
  status         ArticleState @default(DRAFT)
  applicationId  String?      @map("application_id") @db.Uuid
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("legal_documents")
}

model SupportCategory {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  slug        String        @unique
  description String        @default("")
  sortOrder   Int           @default(0) @map("sort_order")
  faqs        FAQ[]
  articles    HelpArticle[]

  @@map("support_categories")
}

model FAQ {
  id            String           @id @default(uuid()) @db.Uuid
  question      String
  answer        String
  categoryId    String?          @map("category_id") @db.Uuid
  applicationId String?          @map("application_id") @db.Uuid
  status        ArticleState     @default(DRAFT)
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      SupportCategory? @relation(fields: [categoryId], references: [id])

  @@map("faqs")
}

model HelpArticle {
  id            String           @id @default(uuid()) @db.Uuid
  title         String
  slug          String           @unique
  excerpt       String           @default("")
  content       String
  categoryId    String?          @map("category_id") @db.Uuid
  applicationId String?          @map("application_id") @db.Uuid
  status        ArticleState     @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      SupportCategory? @relation(fields: [categoryId], references: [id])

  @@map("help_articles")
}

model ContactMessage {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  email         String
  subject       String
  message       String
  kind          MessageKind   @default(GENERAL)
  status        MessageStatus @default(NEW)
  applicationId String?       @map("application_id") @db.Uuid
  abuseHash     String?       @map("abuse_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  application   Application?  @relation(fields: [applicationId], references: [id])

  @@index([status, createdAt])
  @@map("contact_messages")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model NavigationItem {
  id        String  @id @default(uuid()) @db.Uuid
  label     String
  href      String
  group     String
  sortOrder Int     @default(0) @map("sort_order")
  visible   Boolean @default(true)

  @@index([group, visible, sortOrder])
  @@map("navigation_items")
}

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String   @default("page_view")
  path      String
  visitorId String?  @map("visitor_id")
  sessionId String?  @map("session_id")
  referrer  String?
  source    String?
  medium    String?
  campaign  String?
  country   String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt, event])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([source, createdAt])
  @@index([country, createdAt])
  @@index([path, createdAt])
  @@map("analytics_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

enum AppContentState {
  DRAFT
  PUBLISHED
}

enum AppAvailability {
  AVAILABLE
  COMING_SOON
  DISCONTINUED
}

enum ReleaseState {
  DRAFT
  PUBLISHED
}

enum MessageKind {
  GENERAL
  SUPPORT
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ArticleState {
  DRAFT
  PUBLISHED
}

enum MediaRole {
  ICON
  COVER
  SCREENSHOT
  OG
}

enum ReleaseChangeKind {
  ADDED
  IMPROVED
  FIXED
  REMOVED
  SECURITY
}
