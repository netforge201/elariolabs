import { redirect } from 'next/navigation';
import { db } from '@/lib/db';
import { currentAdmin } from '@/lib/auth';
import { requirePermission } from '@/lib/permissions';
import { getAdminNavigation } from '@/lib/admin-navigation';
import { AdminShell } from '../../components';

export const dynamic = 'force-dynamic';

export default async function Analytics() {
  const user = await currentAdmin();
  if (!user) redirect('/admin/login');
  if (user.mustChangePassword) redirect('/admin/change-password');
  if (!await requirePermission('analytics.view')) redirect('/admin?forbidden=1');

  const allowedLinks = await getAdminNavigation();
  const since = new Date(Date.now() - 30 * 86400000);

  const [total, pages, recent] = await Promise.all([
    db.analyticsEvent.count({
      where: { createdAt: { gte: since }, event: 'page_view' },
    }),
    db.analyticsEvent.groupBy({
      by: ['path'],
      where: { createdAt: { gte: since }, event: 'page_view' },
      _count: { _all: true },
      orderBy: { _count: { path: 'desc' } },
      take: 20,
    }),
    db.analyticsEvent.findMany({
      where: { createdAt: { gte: since }, event: 'page_view' },
      orderBy: { createdAt: 'desc' },
      take: 10,
      select: { path: true, createdAt: true },
    }),
  ]);

  return (
    <AdminShell active="Analytics" allowedLinks={allowedLinks}>
      <div className="admin-title">
        <div>
          <div className="eyebrow">Overview / Insights</div>
          <h1>Website Analytics</h1>
          <p>Privacy-friendly aggregate page views for the last 30 days.</p>
        </div>
      </div>

      <div className="metrics">
        <div className="metric">
          <span className="eyebrow">Total page views</span>
          <strong>{total.toLocaleString()}</strong>
        </div>
        <div className="metric">
          <span className="eyebrow">Pages tracked</span>
          <strong>{pages.length}</strong>
        </div>
        <div className="metric">
          <span className="eyebrow">Reporting period</span>
          <strong>30 days</strong>
        </div>
      </div>

      <section className="card" style={{ marginBottom: '1rem' }}>
        <h2>Most visited pages</h2>
        {pages.length ? (
          <div className="tablewrap">
            <table className="table">
              <thead>
                <tr><th>Page</th><th>Views</th></tr>
              </thead>
              <tbody>
                {pages.map((page) => (
                  <tr key={page.path}>
                    <td><a href={page.path} target="_blank" rel="noreferrer">{page.path}</a></td>
                    <td><strong>{page._count._all.toLocaleString()}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div className="empty">
            <h2>Waiting for page views</h2>
            <p>Visit the public website to start collecting anonymous aggregate page views.</p>
          </div>
        )}
      </section>

      <section className="card">
        <h2>Recent activity</h2>
        {recent.length ? (
          <div className="tablewrap">
            <table className="table">
              <thead><tr><th>Page</th><th>Date</th></tr></thead>
              <tbody>
                {recent.map((event, index) => (
                  <tr key={`${event.path}-${event.createdAt.toISOString()}-${index}`}>
                    <td>{event.path}</td>
                    <td>{event.createdAt.toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p className="mono">No recorded events yet.</p>}
      </section>
    </AdminShell>
  );
}
